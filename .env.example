# Copy to `.env` to override the Compose defaults.
# Every value below is optional; the defaults let `docker compose up --build`
# work on an empty checkout.

# ---- Frontend (Nginx) -------------------------------------------------------
# The only host port published by the deployment.
FRONTEND_HTTP_PORT=8080

# ---- PostgreSQL (internal only) ---------------------------------------------
POSTGRES_USER=visualise
POSTGRES_PASSWORD=visualise
POSTGRES_DB=visualise

# ---- Backend (internal only) ------------------------------------------------
# Build metadata reported by /healthz and /readyz.
BACKEND_VERSION=dev

# zerolog level: trace | debug | info | warn | error
BACKEND_LOG_LEVEL=info
# json (machine readable) | console (human readable)
BACKEND_LOG_FORMAT=json

# How long the backend waits for PostgreSQL during startup before it fails.
DATABASE_CONNECT_TIMEOUT=60s

# Maximum accepted size of a single ingested agent event, in bytes.
# 2097152 = 2 MiB, the default of the event contract.
MAX_EVENT_BYTES=2097152

# Grace period for in-flight requests on shutdown.
SHUTDOWN_TIMEOUT=15s

# DATABASE_URL is assembled by docker-compose.yml from the POSTGRES_* values
# above. Set it explicitly only when pointing the backend at another database:
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=disable
